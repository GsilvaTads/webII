<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Busca de Cartões</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-100 min-h-screen">
    <header class="bg-slate-900 text-white px-6 py-4">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <h1 class="text-xl font-semibold">Busca de Cartões</h1>
        <a href="/" class="text-sm text-slate-300 hover:text-white transition">← Voltar ao quadro</a>
      </div>
    </header>

    <main class="max-w-4xl mx-auto p-6">
      <section class="bg-white rounded-lg shadow p-4 mb-6">
        <form method="get" action="/cards/search" class="flex gap-2">
          <input
            type="text"
            name="query"
            value="<%= query %>"
            placeholder="Buscar cartão por título..."
            class="flex-1 border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-slate-800"
          />
          <button
            type="submit"
            class="bg-slate-800 text-white px-4 py-2 rounded text-sm font-medium hover:bg-slate-700 transition"
          >
            Buscar
          </button>
        </form>
      </section>

      <section class="space-y-3">
        <h2 class="text-sm font-medium text-slate-600">
          Resultados encontrados: <%= cards.length %>
        </h2>

        <% if (cards.length === 0) { %>
          <div class="bg-white rounded-lg shadow p-6 text-center text-slate-400 text-sm italic">
            Nenhum cartão encontrado para o termo pesquisado.
          </div>
        <% } %>

        <div class="grid gap-3">
          <% cards.forEach((card) => { %>
            <div class="bg-white rounded-lg shadow p-4 border border-slate-200 flex justify-between items-start">
              <div>
                <a href="/cards/<%= card.id %>" class="text-base font-semibold text-slate-800 hover:text-blue-600 hover:underline">
                  <%= card.title %>
                </a>
                <p class="text-xs text-slate-500 mt-1">
                  Coluna: <span class="font-medium text-slate-700"><%= card.columnName %></span>
                </p>
                <% if (card.description) { %>
                  <p class="text-sm text-slate-600 mt-2"><%= card.description %></p>
                <% } %>
              </div>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full border <%= card.priorityBadgeClass %>">
                <%= card.priority %>
              </span>
            </div>
          <% }) %>
        </div>
      </section>
    </main>
  </body>
</html>