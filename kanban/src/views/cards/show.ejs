<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= card.title %> — Detalhe do Cartão</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-100 min-h-screen flex flex-col">
    <header class="bg-slate-900 text-white px-6 py-4">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <h1 class="text-xl font-semibold">Detalhe do Cartão</h1>
        <a href="/" class="text-sm text-slate-300 hover:text-white transition">← Voltar ao quadro</a>
      </div>
    </header>

    <main class="flex-1 p-6 flex items-center justify-center">
      <div class="bg-white rounded-lg shadow-lg border border-slate-200 p-8 max-w-xl w-full">
        <div class="flex justify-between items-start mb-4">
          <h2 class="text-2xl font-bold text-slate-800"><%= card.title %></h2>
          <span class="text-xs font-semibold px-3 py-1 rounded-full border <%= card.priorityBadgeClass %>">
            <%= card.priority %>
          </span>
        </div>

        <div class="space-y-4 text-sm text-slate-600">
          <div>
            <span class="font-medium text-slate-500 block">Coluna Atual:</span>
            <span class="text-slate-800 font-semibold"><%= card.columnName %></span>
          </div>

          <div>
            <span class="font-medium text-slate-500 block">Descrição:</span>
            <p class="text-slate-700 bg-slate-50 p-3 rounded border mt-1">
              <%= card.description ? card.description : 'Sem descrição informada.' %>
            </p>
          </div>

          <div>
            <span class="font-medium text-slate-500 block">Identificador (ID):</span>
            <code class="text-xs text-slate-400 bg-slate-100 px-2 py-1 rounded"><%= card.id %></code>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t flex justify-end">
          <a
            href="/"
            class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white text-sm font-medium rounded transition"
          >
            Voltar ao Quadro
          </a>
        </div>
      </div>
    </main>
  </body>
</html>